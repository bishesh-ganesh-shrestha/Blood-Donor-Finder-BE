<%
  bg = { "blue" => "bg-blue-50", "red" => "bg-red-50", "green" => "bg-green-50",
         "teal" => "bg-teal-50", "purple" => "bg-purple-50", "yellow" => "bg-yellow-50",
         "orange" => "bg-orange-50" }
  text = { "blue" => "text-blue-600", "red" => "text-red-600", "green" => "text-green-600",
           "teal" => "text-teal-600", "purple" => "text-purple-600", "yellow" => "text-yellow-600",
           "orange" => "text-orange-600" }
%>
<div class="rounded-xl border border-gray-100 shadow-sm p-5 <%= bg[color] %> flex flex-col gap-1">
  <span class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= label %></span>
  <span class="text-3xl font-bold <%= text[color] %>"><%= number_with_delimiter(value) %></span>
</div>